# Single env file for the whole monorepo: copy to .env at the repo root.
# The backend and the Vite frontend both read it from here.
# (The Flutter app bundles its own apps/mobile-app/.env — see apps/mobile-app/README.md.)

# ============================================================
# Backend (apps/backend)
# ============================================================

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/itinerary-planner?retryWrites=true&w=majority

# Port the backend listens on (keep in sync with VITE_API_BASE_URL, BACKEND_URL and the mobile app's API_BASE_URL)
PORT=4000

# Frontend origin (used for CORS, password reset links, and share URLs)
FRONTEND_URL=http://localhost:5173

# Backend's own public origin (used to build absolute Google Places photo proxy URLs —
# must be reachable by the browser/mobile client, not just internally)
BACKEND_URL=http://localhost:4000

# Encrypts per-user API keys at rest (32+ characters)
# Generate with: openssl rand -hex 32
ENCRYPTION_SECRET=your-32-plus-character-encryption-secret-here

# JWT secret shared by both the web (cookie) and mobile (bearer) clients
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-here

# Email (SMTP) — trip member invites and leave notifications
# If unset, emails are logged to the server console in development.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="TripPlanner <noreply@example.com>"

# Per-user API keys (OpenAI or Gemini, Google Maps) are configured in Profile — not here.
# Trip owners add keys in the web app; members use the owner's keys for trip operations.

# NODE_ENV is not set here: Vite reads this file too, and NODE_ENV=development in it would make
# `npm run build` produce a development bundle. The backend defaults to development locally;
# production hosts set NODE_ENV=production themselves.

# ============================================================
# Frontend (apps/frontend) — only VITE_* vars are exposed to the browser
# ============================================================

# Backend API base URL
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Mobile app download link (Play Store, App Store, or direct APK URL)
VITE_MOBILE_APP_DOWNLOAD_URL=
