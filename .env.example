# Single env file for the whole monorepo: copy to .env at the repo root.
# The backend and the Vite frontend both read it from here.
# (The Flutter app bundles its own apps/mobile-app/.env — see apps/mobile-app/README.md.)

# ============================================================
# Backend (apps/backend)
# ============================================================

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/itinerary-planner?retryWrites=true&w=majority

# Port the backend listens on (keep in sync with VITE_API_BASE_URL, BACKEND_URL and the mobile app's API_BASE_URL)
PORT=4000

# Port the frontend is served on — the Vite dev server locally, and the PM2 static server in
# production (put a reverse proxy such as nginx in front of both ports on the VPS).
FRONTEND_PORT=5173

# Frontend origin (used for CORS, where sign-in lands, invite emails and share URLs).
# Production must be HTTPS on a hostname, e.g. https://trippin.duckdns.org:50009 — an https
# FRONTEND_URL / BACKEND_URL also turns on the `secure` flag of the session cookie.
FRONTEND_URL=http://localhost:5173

# Backend's own public origin (used to build absolute Google Places photo proxy URLs —
# must be reachable by the browser/mobile client, not just internally).
# Production: https://trippin.duckdns.org:50008
BACKEND_URL=http://localhost:4000

# HTTPS served by Node itself (backend and the frontend server): a certificate for the duckdns
# hostname, e.g. Let's Encrypt's fullchain.pem / privkey.pem. Leave empty for plain http locally, or
# when a reverse proxy on the same machine terminates TLS.
SSL_CERT_PATH=
SSL_KEY_PATH=

# The frontend server forwards /api/* to the backend, so the web app and its API can share one
# port (443 through a reverse proxy). Defaults to the backend on this machine — PORT above, https
# when SSL_* is set. Only set it if the backend runs somewhere else.
BACKEND_INTERNAL_URL=

# Encrypts per-user API keys at rest (32+ characters)
# Generate with: openssl rand -hex 32
ENCRYPTION_SECRET=your-32-plus-character-encryption-secret-here

# JWT secret shared by both the web (cookie) and mobile (bearer) clients
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-here

# Single sign-on — the shared OpenID Connect identity server (one account for Trippin, SpendLog and
# InFrame). There is no Trippin password: sign-in, sign-up and password resets all happen there.
OIDC_ISSUER=https://id-x.duckdns.org:50011
# The web app's confidential client
OIDC_CLIENT_ID=trippin-web
OIDC_CLIENT_SECRET=
# The browser comes back to the BACKEND (the frontend calls it directly at VITE_API_BASE_URL), so
# this is BACKEND_URL + /api/v1/auth/oidc/callback — register exactly this on the identity server.
OIDC_REDIRECT_URI=http://localhost:4000/api/v1/auth/oidc/callback
# Where the identity server sends the browser after sign-out (register it there too)
OIDC_POST_LOGOUT_URI=http://localhost:5173/login
# The Android app's public client (PKCE); ID tokens it sends must carry this audience
OIDC_MOBILE_CLIENT_ID=trippin-mobile

# Email (SMTP) — trip member invites (also to people who haven't signed in yet) and leave notifications
# If unset, emails are logged to the server console in development.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="Trippin' <noreply@example.com>"

# API keys. Each user adds their own in Profile; trip members use the trip owner's keys.
# Google Maps: always the user's own key (Profile → API keys) — there is no shared server key.
# AI: the two keys below are optional shared fallbacks for users without their own; leave empty to
# require per-user keys. Usage is billed to whoever owns these keys.
OPENAI_API_KEY=
GEMINI_API_KEY=

# The suite — SpendLog (trip spending) and InFrame (shared trip photos). A trip's owner can link
# either one, at creation or later from the trip page; Trippin then sends that app signed events
# (trip.linked / updated / members_changed / unlinked) and shows its live summary on the trip.
# Requests are signed with HMAC-SHA256 using a secret shared per app pair: the same value goes in
# SPENDLOG_SUITE_SECRET here and TRIPPIN_SUITE_SECRET on SpendLog (likewise for InFrame).
# Generate each with: openssl rand -hex 32. Leave an app's API URL or secret empty to run without it
# (links to it stay queued with an error until it's set up).
SPENDLOG_API_URL=https://spend-log.duckdns.org:50002/api
SPENDLOG_SUITE_SECRET=
# Public pages for "Open in SpendLog" links and the promo card (the APK is how Android users install it)
SPENDLOG_WEB_URL=https://spend-log.duckdns.org:50002
SPENDLOG_APK_URL=https://spend-log.duckdns.org:50002/SpendLog.apk

INFRAME_API_URL=https://in-frame.duckdns.org:50010/api
INFRAME_SUITE_SECRET=
INFRAME_WEB_URL=https://in-frame.duckdns.org:50010
# InFrame serves its release APK at /inframe.apk (defaults to INFRAME_WEB_URL/inframe.apk)
INFRAME_APK_URL=https://in-frame.duckdns.org:50010/inframe.apk

# NODE_ENV is not set here: Vite reads this file too, and NODE_ENV=development in it would make
# `npm run build` produce a development bundle. The backend defaults to development locally;
# production hosts set NODE_ENV=production themselves.

# ============================================================
# Frontend (apps/frontend) — only VITE_* vars are exposed to the browser
# ============================================================

# Backend API base URL (production: https://trippin.duckdns.org:50008/api/v1). The "Sign in" button
# goes to <this>/auth/oidc/start.
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Mobile app download link (Play Store, App Store, or direct APK URL)
VITE_MOBILE_APP_DOWNLOAD_URL=
