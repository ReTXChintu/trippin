{
  "git": {
    "commitMessage": "chore(release): v${version}",
    "tagName": "v${version}",
    "requireCleanWorkingDir": true,
    "requireUpstream": false,
    "commit": true,
    "tag": true,
    "push": false
  },
  "github": {
    "release": false
  },
  "npm": {
    "publish": false
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": "angular",
      "infile": "CHANGELOG.md"
    }
  },
  "hooks": {
    "before:init": "cd apps/mobile-app && flutter pub get",
    "after:bump": [
      "node scripts/sync-all-versions.js",
      "npm run build:apk --prefix apps/mobile-app",
      "node apps/mobile-app/scripts/copy-apk.js"
    ]
  }
}
