# Trippin API base URL (include /api/v1). Production:
API_BASE_URL=http://187.127.179.114:50008/api/v1
# Trippin website — planning (defaults to the API host without /api/v1).
WEB_URL=http://187.127.179.114:50009
# Map tiles. OpenStreetMap's servers allow light use only; for many users, use a provider that
# permits offline saving (e.g. MapTiler: https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY).
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Sign-in: the shared OpenID Connect identity server (one account for Trippin, SpendLog and InFrame).
# Must be HTTPS with a real certificate on a phone. The app is its public client "trippin-mobile"
# (PKCE), redirect URI com.itineraryplanner.itinerary-planner:/oauth2redirect.
OIDC_ISSUER=https://id-x.duckdns.org:50011
# Optional — defaults to trippin-mobile.
# OIDC_CLIENT_ID=trippin-mobile
#
# Local testing — Android emulator: http://10.0.2.2:<PORT>/api/v1 · phone on Wi-Fi: http://<your-pc-lan-ip>:<PORT>/api/v1
